--color@ext_c_hshadow:HD影色,0x00ffff
--group

local telop = require("custom_telop_presets")

local text = obj.getvalue("テキスト","テキスト")
local count = 1
local i = 0
if type(text) == "string" then
    while true do
        i = string.find(text, "\\n", i + 1)
        if not i then break end
        local prev_char = string.sub(text, i - 1, i - 1)
        if prev_char ~= "\\" then
            count = count + 1
        end
    end
end

local prisets_resize = 1
if(text_alter_size ~= 0) then
    local w, h = obj.getpixel()
    prisets_resize = (h/100) / math.max(1,count)
else
    prisets_resize = 1
end

local user_grad_execution = function()
    local condition, AKIRA_helper = pcall(require, "AKIRA_aviutl2_helper")

    local AKIRA_h = nil
    if condition then
        AKIRA_h = AKIRA_helper
    else
        debug_print("AKIRA_aviutl2_helper.luaが同じフォルダに存在しません。")
    end

    local GRD_TYPES = {"線形", "円形", "矩形", "凸形"}
    local GRD_COMPOSITES = {"通常", "加算", "減算", "乗算", "スクリーン", "オーバーレイ", "比較(明)", "比較(暗)", "輝度", "色差", "陰影", "明暗", "差分"}

    local my_resize = 1
    if condition and AKIRA_h and AKIRA_h.get_text_resize then
        my_resize = AKIRA_h.get_text_resize()
    end
    if alter_size == 0 then
        my_resize = 1
    end

    if grd_enable ~= 0 then
        local g_type = GRD_TYPES[grd_type] or "線形"
        local g_comp = GRD_COMPOSITES[grd_composite] or "通常"
        local noC1 = (grd_start_col == nil) and 1 or 0
        local noC2 = (grd_end_col == nil) and 1 or 0

        obj.effect("グラデーション",
            "強さ",      grd_pow,
            "中心X",     grd_x * my_resize,
            "中心Y",     grd_y * my_resize,
            "角度",      grd_rotate,
            "幅",        grd_width * my_resize,
            "合成モード", g_comp,
            "形状",      g_type,
            "開始色",    grd_start_col,
            "no_color",  noC1,
            "終了色",    grd_end_col,
            "no_color2", noC2
        )
    end
end

local params = {
    deco = 1,
    deco2 = deco2, deco3 = deco3, deco4 = deco4, deco5 = deco5,
    deco6 = deco6, deco7 = deco7, deco8 = deco8, deco9 = deco9, deco10 = deco10,
    deco11 = deco11, deco12 = deco12, deco13 = deco13, deco14 = deco14,

    cen = ext_c_text_en, ct = ext_c_text,
    cb1_en = ext_c_b1_en, cb1 = ext_c_b1,
    cb2_en = ext_c_b2_en, cb2 = ext_c_b2,
    cb3_en = ext_c_b3_en, cb3 = ext_c_b3,
    cs_en = ext_c_shadow_en, cs = ext_c_shadow,
    chs_en = ext_c_hshadow_en, chs = ext_c_hshadow,
    b1 = ext_b1_size, b2 = ext_b2_size, b3 = ext_b3_size,
    sx = ext_s_x, sy = ext_s_y, sa = ext_s_alpha, sd = ext_s_diff,
    hx = ext_h_x, hy = ext_h_y, ha = ext_h_alpha,
    
    prisets_resize = prisets_resize,
    custom_grad_func = user_grad_execution
}

telop.telop_presets(params)